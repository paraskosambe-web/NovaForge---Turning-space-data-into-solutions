# Assistant defaults to DEMO (cached) unless a provider and key are configured.
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_MS=300000

# npm run ingest fetches PSI search metadata and normalizes the returned investigations.
PSI_API_BASE=https://psi.nasa.gov/geode-py/ws
PSI_OFFLINE=false
